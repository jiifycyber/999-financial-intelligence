import 'package:flutter/material.dart';

class AppTheme {
  // XXX DEFENSE-inspired financial command palette
  static const bg = Color(0xFF01050F);
  static const midnight = Color(0xFF050B1A);

  static const panel = Color(0xFF071D42);
  static const panel2 = Color(0xFF092149);
  static const panelDark = Color(0xFF06142D);

  static const border = Color(0xFF315D8A);

  static const gold = Color(0xFFE2B84F);
  static const goldSoft = Color(0xFF8D7131);

  static const green = Color(0xFF22E89A);
  static const cyan = Color(0xFF25EDFF);

  static const purple = Color(0xFFA23CFF);
  static const purpleBright = Color(0xFFD43CFF);
  static const pink = Color(0xFFFF4D87);

  static const blue = Color(0xFF25AFFF);

  static const orange = Color(0xFFFFC857);
  static const red = Color(0xFFFF4D5A);

  static const text = Color(0xFFF3F8FC);
  static const muted = Color(0xFF9DAAC6);

  static ThemeData get dark {
    final scheme = ColorScheme.fromSeed(
      seedColor: purple,
      brightness: Brightness.dark,
      surface: panel,
      error: red,
    );

    return ThemeData(
      useMaterial3: true,
      brightness: Brightness.dark,
      scaffoldBackgroundColor: bg,
      colorScheme: scheme,
      dividerColor: border,
      cardColor: panel,
      textTheme: const TextTheme(
        headlineLarge: TextStyle(
          color: text,
          fontSize: 30,
          fontWeight: FontWeight.w800,
          letterSpacing: 1.2,
        ),
        headlineMedium: TextStyle(
          color: text,
          fontSize: 21,
          fontWeight: FontWeight.w800,
          letterSpacing: 1,
        ),
        titleLarge: TextStyle(
          color: text,
          fontSize: 16,
          fontWeight: FontWeight.w800,
          letterSpacing: .8,
        ),
        bodyMedium: TextStyle(
          color: muted,
          fontSize: 13,
          height: 1.35,
        ),
      ),
      cardTheme: const CardThemeData(
        color: panel,
        elevation: 0,
        margin: EdgeInsets.zero,
      ),
      dialogTheme: const DialogThemeData(
        backgroundColor: panel2,
      ),
      snackBarTheme: const SnackBarThemeData(
        backgroundColor: panel2,
        contentTextStyle: TextStyle(color: text),
      ),
    );
  }
}
