class ModuleScreen extends StatelessWidget {
  final String title;
  final String subtitle;
  final List<String> features;

  const ModuleScreen({
    super.key,
    required this.title,
    required this.subtitle,
    required this.features,
  });

  IconData get moduleIcon {
    final t = title.toLowerCase();

    if (t.contains('credit')) return Icons.credit_score_rounded;
    if (t.contains('funding')) return Icons.account_balance_rounded;
    if (t.contains('grant')) return Icons.workspace_premium_rounded;
    if (t.contains('crm')) return Icons.groups_2_rounded;
    if (t.contains('document')) return Icons.folder_copy_rounded;
    if (t.contains('analytic')) return Icons.query_stats_rounded;
    if (t.contains('admin')) return Icons.admin_panel_settings_rounded;
    if (t.contains('coach') || t.contains('ai')) {
      return Icons.psychology_alt_rounded;
    }

    return Icons.auto_awesome_rounded;
  }

  Color get accent {
    final t = title.toLowerCase();

    if (t.contains('credit')) return const Color(0xFFB56AFF);
    if (t.contains('funding')) return const Color(0xFF57CFFF);
    if (t.contains('grant')) return const Color(0xFFFFBF55);
    if (t.contains('crm')) return const Color(0xFF51E0D4);
    if (t.contains('analytic')) return const Color(0xFF55DFFF);
    if (t.contains('admin')) return const Color(0xFFFF69C9);

    return const Color(0xFFAE72FF);
  }

  String get category {
    final t = title.toLowerCase();

    if (t.contains('credit')) return 'CREDIT INTELLIGENCE';
    if (t.contains('funding')) return 'FUNDING INTELLIGENCE';
    if (t.contains('grant')) return 'GRANT INTELLIGENCE';
    if (t.contains('crm')) return 'RELATIONSHIP INTELLIGENCE';
    if (t.contains('document')) return 'DOCUMENT INTELLIGENCE';
    if (t.contains('analytic')) return 'FINANCIAL ANALYTICS';
    if (t.contains('admin')) return 'SYSTEM ADMINISTRATION';
    if (t.contains('coach') || t.contains('ai')) {
      return 'AI FINANCIAL INTELLIGENCE';
    }

    return title.toUpperCase();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF09060F),
      body: SafeArea(
        child: LayoutBuilder(
          builder: (context, constraints) {
            final mobile = constraints.maxWidth < 760;

            return Column(
              children: [
                _FinancialTopBar(
                  mobile: mobile,
                  accent: accent,
                ),
                Expanded(
                  child: Row(
                    children: [
                      if (!mobile) const FinancialSidebar(),
                      Expanded(
                        child: Container(
                          decoration: const BoxDecoration(
                            gradient: LinearGradient(
                              begin: Alignment.topLeft,
                              end: Alignment.bottomRight,
                              colors: [
                                Color(0xFF08050C),
                                Color(0xFF09060F),
                                Color(0xFF07152E),
                              ],
                            ),
                          ),
                          child: SingleChildScrollView(
                            padding: EdgeInsets.fromLTRB(
                              mobile ? 12 : 24,
                              mobile ? 14 : 22,
                              mobile ? 12 : 24,
                              30,
                            ),
                            child: Center(
                              child: ConstrainedBox(
                                constraints: const BoxConstraints(
                                  maxWidth: 1380,
                                ),
                                child: _ConnectModulePanel(
                                  title: title,
                                  category: category,
                                  subtitle: subtitle,
                                  features: features,
                                  icon: moduleIcon,
                                  accent: accent,
                                  mobile: mobile,
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                if (mobile) const FinancialMobileNavigation(),
              ],
            );
          },
        ),
      ),
    );
  }
}

