class ModuleScreen extends StatelessWidget {
  final String title;
  final String subtitle;
  final List<String> features;

  const ModuleScreen({
    super.key,
    required this.title,
    required this.subtitle,
    required this.features,
  });

  IconData get moduleIcon {
    final t = title.toLowerCase();

    if (t.contains('credit')) return Icons.credit_score_outlined;
    if (t.contains('funding')) return Icons.account_balance_outlined;
    if (t.contains('grant')) return Icons.description_outlined;
    if (t.contains('crm')) return Icons.groups_2_outlined;
    if (t.contains('document')) return Icons.folder_copy_outlined;
    if (t.contains('analytic')) return Icons.query_stats_outlined;
    if (t.contains('admin')) return Icons.admin_panel_settings_outlined;
    if (t.contains('coach') || t.contains('ai')) {
      return Icons.psychology_outlined;
    }

    return Icons.auto_awesome_outlined;
  }

  Color get accent {
    final t = title.toLowerCase();

    if (t.contains('credit')) return AppTheme.purple;
    if (t.contains('funding')) return AppTheme.blue;
    if (t.contains('grant')) return AppTheme.cyan;
    if (t.contains('crm')) return AppTheme.green;

    return AppTheme.purple;
  }

  String get category {
    final t = title.toLowerCase();

    if (t.contains('credit')) return 'CREDIT INTELLIGENCE';
    if (t.contains('funding')) return 'BUSINESS FUNDING';
    if (t.contains('grant')) return 'GRANT INTELLIGENCE';
    if (t.contains('crm')) return 'CUSTOMER RELATIONSHIP MANAGEMENT';

    return title.toUpperCase();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppTheme.bg,
      body: SafeArea(
        child: LayoutBuilder(
          builder: (context, constraints) {
            final mobile = constraints.maxWidth < 760;

            return Column(
              children: [
                _TopBar(
                  mobile: mobile,
                  accent: accent,
                ),
                Expanded(
                  child: Row(
                    children: [
                      if (!mobile) _Sidebar(activeTitle: title),
                      Expanded(
                        child: Container(
                          decoration: const BoxDecoration(
                            gradient: LinearGradient(
                              begin: Alignment.topLeft,
                              end: Alignment.bottomRight,
                              colors: [
                                Color(0xFF01050F),
                                Color(0xFF071D42),
                                Color(0xFF01050F),
                              ],
                            ),
                          ),
                          child: SingleChildScrollView(
                            padding: EdgeInsets.fromLTRB(
                              mobile ? 14 : 26,
                              20,
                              mobile ? 14 : 26,
                              28,
                            ),
                            child: Center(
                              child: ConstrainedBox(
                                constraints: const BoxConstraints(
                                  maxWidth: 1380,
                                ),
                                child: Column(
                                  crossAxisAlignment:
                                      CrossAxisAlignment.stretch,
                                  children: [
                                    _HeroHeader(
                                      title: title,
                                      category: category,
                                      subtitle: subtitle,
                                      icon: moduleIcon,
                                      accent: accent,
                                      mobile: mobile,
                                    ),
                                    const SizedBox(height: 18),
                                    _MetricStrip(
                                      title: title,
                                      accent: accent,
                                    ),
                                    const SizedBox(height: 18),
                                    _SectionHeader(
                                      title: 'TOOLS & WORKFLOWS',
                                      subtitle:
                                          'Access the intelligence tools for this module.',
                                      accent: accent,
                                    ),
                                    const SizedBox(height: 12),
                                    _FeatureGrid(
                                      features: features,
                                      accent: accent,
                                      mobile: mobile,
                                    ),
                                    const SizedBox(height: 18),
                                    _AgentDukePanel(
                                      moduleTitle: title,
                                      accent: accent,
                                    ),
                                  ],
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                if (mobile) _MobileNav(activeTitle: title),
              ],
            );
          },
        ),
      ),
    );
  }
}

