                  child: Icon(
                    Icons.smart_toy_outlined,
                    color: AppTheme.purple,
                  ),
                ),
                SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Agent Duke',
                        style: TextStyle(
                          color: AppTheme.text,
                          fontSize: 11,
                          fontWeight: FontWeight.w900,
                        ),
                      ),
                      SizedBox(height: 2),
                      Text(
                        'Financial AI Online',
                        style: TextStyle(
                          color: AppTheme.green,
                          fontSize: 8,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  bool _isActive(String label) {
    final a = activeTitle.toLowerCase();
    final b = label.toLowerCase();

    if (a.contains('credit') && b.contains('credit')) return true;
    if (a.contains('funding') && b.contains('funding')) return true;
    if (a.contains('grant') && b.contains('grant')) return true;
    if (a.contains('crm') && b == 'crm') return true;
    if (a.contains('document') && b.contains('document')) return true;
    if (a.contains('analytic') && b.contains('analytic')) return true;
    if (a.contains('admin') && b.contains('admin')) return true;
    if ((a.contains('coach') || a.contains('ai')) &&
        b.contains('financial coach')) {
      return true;
    }

    return false;
  }
}

