      ('HOME', Icons.dashboard_customize_outlined, '/'),
      ('CREDIT', Icons.credit_score_outlined, '/credit'),
      ('GRANTS', Icons.description_outlined, '/grants'),
      ('FUNDING', Icons.account_balance_outlined, '/funding'),
      ('AI', Icons.psychology_outlined, '/ai-coach'),
    ];

    return Container(
      height: 72,
      decoration: const BoxDecoration(
        color: Color(0xFF050B1A),
        border: Border(
          top: BorderSide(color: AppTheme.border),
        ),
      ),
      child: Row(
        children: [
          for (final entry in entries)
            Expanded(
              child: InkWell(
                onTap: () => context.go(entry.$3),
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Icon(
                      entry.$2,
                      color:
                          _active(entry.$1) ? AppTheme.purple : AppTheme.muted,
                      size: 21,
                    ),
                    const SizedBox(height: 5),
                    Text(
                      entry.$1,
                      style: TextStyle(
                        color:
                            _active(entry.$1) ? AppTheme.text : AppTheme.muted,
                        fontSize: 7,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                  ],
                ),
              ),
            ),
        ],
      ),
    );
  }

  bool _active(String nav) {
    final t = activeTitle.toLowerCase();

    if (nav == 'CREDIT' && t.contains('credit')) return true;
    if (nav == 'GRANTS' && t.contains('grant')) return true;
    if (nav == 'FUNDING' && t.contains('funding')) return true;

    return false;
  }
}
