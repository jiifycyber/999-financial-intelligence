        : t.contains('grant')
            ? [
                ('Matches', 'Scan', 'Find opportunities'),
                ('Saved', '0', 'Saved grants'),
                ('Applications', '0', 'In progress'),
                ('AI Status', 'Online', 'Matching ready'),
              ]
            : t.contains('funding')
                ? [
                    ('Readiness', 'Scan', 'Assess profile'),
                    ('Matches', '0', 'Funding sources'),
                    ('Applications', '0', 'In progress'),
                    ('AI Status', 'Online', 'Funding AI ready'),
