class _FeatureGrid extends StatelessWidget {
  final List<String> features;
  final Color accent;
  final bool mobile;

  const _FeatureGrid({
    required this.features,
    required this.accent,
    required this.mobile,
  });

  @override
  Widget build(BuildContext context) {
    return GridView.builder(
      itemCount: features.length,
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: mobile ? 1 : 2,
        mainAxisExtent: 88,
        crossAxisSpacing: 12,
        mainAxisSpacing: 12,
      ),
      itemBuilder: (_, i) {
        final feature = features[i];

        return InkWell(
          onTap: () {},
          borderRadius: BorderRadius.circular(16),
          child: Container(
            padding: const EdgeInsets.symmetric(
              horizontal: 14,
              vertical: 12,
            ),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(16),
              gradient: const LinearGradient(
                begin: Alignment.topLeft,
                end: Alignment.bottomRight,
                colors: [
                  Color(0xFF092149),
                  Color(0xFF06142D),
                ],
              ),
              border: Border.all(
                color: accent.withValues(alpha: .22),
              ),
            ),
            child: Row(
              children: [
                Container(
                  width: 44,
                  height: 44,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: accent.withValues(alpha: .12),
                  ),
                  child: Icon(
                    _featureIcon(feature),
                    color: accent,
                    size: 22,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Text(
                    feature,
                    style: const TextStyle(
                      color: AppTheme.text,
                      fontSize: 11,
                      fontWeight: FontWeight.w800,
                    ),
                  ),
                ),
                const Icon(
                  Icons.chevron_right,
                  color: AppTheme.muted,
                  size: 18,
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  IconData _featureIcon(String feature) {
    final f = feature.toLowerCase();

    if (f.contains('credit') || f.contains('score')) {
      return Icons.credit_score_outlined;
    }
    if (f.contains('document')) return Icons.description_outlined;
    if (f.contains('deadline') || f.contains('reminder')) {
      return Icons.schedule_outlined;
    }
    if (f.contains('payment') || f.contains('billing')) {
      return Icons.payments_outlined;
    }
    if (f.contains('customer') || f.contains('profile')) {
      return Icons.person_outline;
    }
    if (f.contains('task')) return Icons.task_alt_outlined;
    if (f.contains('appointment')) return Icons.calendar_month_outlined;
    if (f.contains('communication')) return Icons.chat_bubble_outline;
    if (f.contains('funding') || f.contains('loan')) {
      return Icons.account_balance_outlined;
    }
    if (f.contains('grant')) return Icons.workspace_premium_outlined;
    if (f.contains('ai')) return Icons.auto_awesome_outlined;

    return Icons.auto_awesome_outlined;
  }
}

